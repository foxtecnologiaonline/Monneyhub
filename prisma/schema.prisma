// Schema Postgres compartilhado das camadas de infra do MonneyHub.
// Ver docs/00-visao-geral-e-camadas-compartilhadas.md — Fase 0.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "memory", "finance"]
}

// --- schema "core" ---------------------------------------------------
// Base multi-tenant. O Gateway WhatsApp identifica o tenant a partir do
// phone_number_id do webhook da Meta Business API contra esta tabela.

model Tenant {
  id                    String   @id @default(uuid())
  name                  String
  whatsappPhoneNumberId String   @unique
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@schema("core")
}

// --- schema "memory" ---------------------------------------------------
// Serviço de Memória/Contexto do Usuário (Camada C). Não pertence a
// nenhum produto específico — PersonAI é o primeiro consumidor.

enum MemoryKind {
  PREFERENCE
  FACT
  INTERACTION

  @@schema("memory")
}

model MemoryEntry {
  id        String     @id @default(uuid())
  tenantId  String
  userId    String
  kind      MemoryKind
  key       String
  value     Json
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // PREFERENCE e FACT são chave única por usuário (upsert); INTERACTION
  // usa uma key gerada por evento, então não colide.
  @@unique([tenantId, userId, kind, key])
  @@index([tenantId, userId])
  @@schema("memory")
}

// --- schema "finance" --------------------------------------------------
// Dado financeiro interno do MonneyHub (Fase 1). É o que o MonneyHub Zap
// consulta pra responder saldo/extrato sem depender de fonte externa.
// Decimal e não float/int: centavo de real não sobrevive a binário flutuante.

model Account {
  id        String   @id @default(uuid())
  tenantId  String
  /// wa_id do usuário no WhatsApp — mesma chave que o Gateway normaliza.
  userId    String
  name      String
  balance   Decimal  @db.Decimal(14, 2)
  currency  String   @default("BRL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  // v1: uma conta por usuário por tenant.
  @@unique([tenantId, userId])
  @@schema("finance")
}

model Transaction {
  id          String   @id @default(uuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  description String
  /// Negativo = saída, positivo = entrada.
  amount      Decimal  @db.Decimal(14, 2)
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  @@index([accountId, occurredAt])
  @@schema("finance")
}

/// Execução do MEI-Oráculo. Guardar o MAPE por execução é o que permite
/// "expor a precisão internamente" em vez de prometer número sem medir.
model ForecastRun {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String
  runAt         DateTime @default(now())
  /// OK | INSUFFICIENT_HISTORY
  status        String
  /// [{ horizonDays, p10, p50, p90 }]
  horizons      Json
  historyMonths Decimal  @db.Decimal(6, 2)
  mape          Decimal? @db.Decimal(8, 2)
  alertLeadDays Int?
  alertAtDay    Int?
  exportKey     String?

  @@index([tenantId, userId, runAt])
  @@schema("finance")
}
