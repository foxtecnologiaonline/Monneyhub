// Schema Postgres compartilhado das camadas de infra do MonneyHub.
// Ver docs/00-visao-geral-e-camadas-compartilhadas.md — Fase 0.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "memory", "finance"]
}

// --- schema "core" ---------------------------------------------------
// Base multi-tenant. O Gateway WhatsApp identifica o tenant a partir do
// phone_number_id do webhook da Meta Business API contra esta tabela.

model Tenant {
  id                    String   @id @default(uuid())
  name                  String
  whatsappPhoneNumberId String   @unique
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@schema("core")
}

// --- schema "memory" ---------------------------------------------------
// Serviço de Memória/Contexto do Usuário (Camada C). Não pertence a
// nenhum produto específico — PersonAI é o primeiro consumidor.

enum MemoryKind {
  PREFERENCE
  FACT
  INTERACTION

  @@schema("memory")
}

model MemoryEntry {
  id        String     @id @default(uuid())
  tenantId  String
  userId    String
  kind      MemoryKind
  key       String
  value     Json
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // PREFERENCE e FACT são chave única por usuário (upsert); INTERACTION
  // usa uma key gerada por evento, então não colide.
  @@unique([tenantId, userId, kind, key])
  @@index([tenantId, userId])
  @@schema("memory")
}

// --- schema "finance" --------------------------------------------------
// Dado financeiro interno do MonneyHub (Fase 1): o que o MonneyHub Zap
// consulta pra responder saldo/extrato e o histórico que o MEI-Oráculo
// usa como série de treino.
// Decimal e não float/int: centavo de real não sobrevive a binário flutuante.

model Account {
  id       String @id @default(uuid())
  tenantId String
  /// wa_id do usuário no WhatsApp — mesma chave que o Gateway normaliza.
  userId   String
  name     String
  currency String @default("BRL")

  // O saldo é derivado das transações, não materializado: manter saldo
  // armazenado exige dois lugares em sincronia e ele diverge calado quando
  // um lançamento entra fora do caminho feliz.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  // v1: uma conta por usuário por tenant.
  @@unique([tenantId, userId])
  @@schema("finance")
}

model Transaction {
  id          String   @id @default(uuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  description String
  /// Negativo = saída, positivo = entrada.
  amount      Decimal  @db.Decimal(14, 2)
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  @@index([accountId, occurredAt])
  @@schema("finance")
}

// --- MEI-Oráculo -------------------------------------------------------
// Previsão de fluxo de caixa gerada pelo Amazon Forecast.

enum ForecastStatus {
  /// Menos de 6 meses de histórico — não dá pra treinar ainda.
  AWAITING_DATA
  TRAINING
  READY
  FAILED

  @@schema("finance")
}

model ForecastRun {
  id             String         @id @default(uuid())
  tenantId       String
  userId         String
  status         ForecastStatus
  /// Meses de histórico disponíveis quando a rodada começou.
  historyMonths  Int
  /// Saldo no momento do treino — a previsão é acumulada a partir dele.
  openingBalance Decimal        @db.Decimal(14, 2)
  predictorArn   String?
  forecastArn    String?
  /// Erro percentual médio medido em backtest. Exposto internamente — não
  /// prometemos precisão sem medir (critério de aceite do escopo).
  mape           Float?
  failureReason  String?
  trainedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  points ForecastPoint[]

  @@index([tenantId, userId, createdAt])
  @@schema("finance")
}

model ForecastPoint {
  id    String      @id @default(uuid())
  runId String
  run   ForecastRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// Série diária de saldo previsto — o alerta precisa saber em que dia o
  /// P50 cruza zero, não só o valor no dia 30/60/90.
  date  DateTime    @db.Date
  p10   Float
  p50   Float
  p90   Float

  @@unique([runId, date])
  @@index([runId, date])
  @@schema("finance")
}

/// Estágios do pipeline do Amazon Forecast. Import, treino e geração são
/// assíncronos e levam horas — o job semanal cria o pipeline e um tick
/// frequente avança um estágio por vez consultando o ARN corrente.
enum PipelineStage {
  IMPORTING
  TRAINING
  FORECASTING
  QUERYING
  DONE
  FAILED

  @@schema("finance")
}

model ForecastPipeline {
  id            String        @id @default(uuid())
  stage         PipelineStage
  s3Path        String
  importJobArn  String?
  predictorArn  String?
  forecastArn   String?
  failureReason String?
  startedAt     DateTime      @default(now())
  finishedAt    DateTime?
  updatedAt     DateTime      @updatedAt

  @@index([stage])
  @@schema("finance")
}
