# Postgres — schemas "core", "memory" e "finance" vivem no mesmo banco (ver
# prisma/schema.prisma). Valores default batem com docker-compose.yml —
# suba com `docker compose up -d` e não precisa mudar nada aqui pra dev local.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/monneyhub?schema=public"

# Redis — fila BullMQ do Gateway WhatsApp
REDIS_URL="redis://localhost:6379"

# Meta Business API (WhatsApp Cloud API)
META_WEBHOOK_VERIFY_TOKEN="defina-um-token-qualquer-pro-handshake-do-webhook"
META_APP_SECRET="app-secret-do-app-da-meta"
META_ACCESS_TOKEN="access-token-permanente-do-numero-de-whatsapp"

# Claude — classificador de intenção (sem isso, cai no fallback por keyword)
ANTHROPIC_API_KEY=""

# Chave compartilhada entre serviços internos FOX (memory service não é público)
INTERNAL_API_KEY="defina-uma-chave-interna"

# Perplexity Router API — contexto de mercado em tempo real do MonneyHub Zap.
# Sem a key, pergunta de mercado responde com mensagem de indisponibilidade.
PERPLEXITY_API_KEY=""
PERPLEXITY_BASE_URL="https://api.perplexity.ai"
PERPLEXITY_MODEL="sonar"

# Azure AI Content Safety — guarda de conteúdo do MonneyHub Zap.
# Sem credencial: passa em dev, BLOQUEIA em produção (NODE_ENV=production).
AZURE_CONTENT_SAFETY_ENDPOINT=""
AZURE_CONTENT_SAFETY_KEY=""
# Severidade mínima que bloqueia a resposta (Azure usa 0/2/4/6). Padrão: 4.
AZURE_CONTENT_SAFETY_BLOCK_SEVERITY="4"

# Export do histórico do MEI-Oráculo (S3 ou R2). Sem o bucket, a previsão
# roda normal e só o export é pulado.
FORECAST_EXPORT_BUCKET=""
AWS_REGION="us-east-1"
# Preencher só pra S3-compatível não-AWS (ex.: Cloudflare R2).
S3_ENDPOINT=""
