# Postgres — schemas "core", "memory" e "monneyhub" vivem no mesmo banco
DATABASE_URL="postgresql://user:password@localhost:5432/monneyhub?schema=public"

# Redis — filas BullMQ (gateway WhatsApp, alertas, pipeline de previsão)
REDIS_URL="redis://localhost:6379"

# --- Camada A: Gateway WhatsApp -----------------------------------------
# Meta Business API (WhatsApp Cloud API)
META_WEBHOOK_VERIFY_TOKEN="defina-um-token-qualquer-pro-handshake-do-webhook"
META_APP_SECRET="app-secret-do-app-da-meta"
META_ACCESS_TOKEN="access-token-permanente-do-numero-de-whatsapp"

# Claude — classificador de intenção (sem isso, cai no fallback por keyword)
ANTHROPIC_API_KEY=""

# Chave compartilhada entre serviços internos FOX (APIs internas não são públicas)
INTERNAL_API_KEY="defina-uma-chave-interna"

# --- MEI-Oráculo: Amazon Forecast ---------------------------------------
AWS_REGION="us-east-1"
FORECAST_S3_BUCKET="monneyhub-forecast"
# Provisionados como infraestrutura (Terraform/console), não pela aplicação:
FORECAST_DATASET_ARN="arn:aws:forecast:us-east-1:000000000000:dataset/monneyhub"
FORECAST_DATASET_GROUP_ARN="arn:aws:forecast:us-east-1:000000000000:dataset-group/monneyhub"
FORECAST_ROLE_ARN="arn:aws:iam::000000000000:role/monneyhub-forecast"

# --- MonneyHub Zap ------------------------------------------------------
# Perplexity Router API — contexto de mercado em tempo real
PERPLEXITY_API_KEY=""
PERPLEXITY_MODEL="sonar"

# Azure AI Content Safety — guarda antes de qualquer resposta sair.
# Sem estas duas variáveis o texto passa direto (dev); em produção são obrigatórias.
AZURE_CONTENT_SAFETY_ENDPOINT=""
AZURE_CONTENT_SAFETY_KEY=""
AZURE_CONTENT_SAFETY_THRESHOLD="4"
